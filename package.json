{
  "name": "axionix",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "prisma generate --schema=apps/marketing/prisma/schema.prisma",
    "db:push": "prisma db push --schema=apps/marketing/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=apps/marketing/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
